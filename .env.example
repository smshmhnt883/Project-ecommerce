# ==============================================================================
# Patanjali Store - Environment Variables Configuration
# ==============================================================================

# InsForge BaaS Configuration
# Obtain your Project URL and Anon Key from the InsForge Dashboard or CLI (`npx @insforge/cli metadata`)
NEXT_PUBLIC_INSFORGE_URL="https://your-project-id.insforge.app"
NEXT_PUBLIC_INSFORGE_ANON_KEY="your_insforge_public_anon_key"
INSFORGE_PROJECT_ID="your_insforge_project_id"
INSFORGE_API_KEY="your_insforge_service_role_admin_api_key"

# Razorpay Gateway Integration
# Public key is accessible to client-side modal checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"

# Server-only secrets - strictly keep server-side, never expose to client
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Mode configuration
NEXT_PUBLIC_DEMO_MODE="false"
NEXT_PUBLIC_PAYMENT_MODE="razorpay"
